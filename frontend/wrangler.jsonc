{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "guardlink",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-11-05",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    {
      "binding": "API",
      "service": "guardlink-api"
    }
  ],
  "observability": {
    "enabled": true
  },
  "routes": [
    {
      "pattern": "guardlink.ajnasnb.com",
      "custom_domain": true
    }
  ],
  "workers_dev": true
}
